---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeClients from '../components/home/HomeClients.astro';
import HomeWorks from '../components/home/HomeWorks.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeCases from '../components/home/HomeCases.astro';
import HomeTeam from '../components/home/HomeTeam.astro';
import HomeReviews from '../components/home/HomeReviews.astro';
import HomeArticles from '../components/home/HomeArticles.astro';
import HomeContact from '../components/home/HomeContact.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import '../styles/home.css';

import home from '../../content/pages/home-v2.json';
import globalSettings from '../../content/settings/global.json';

const H: any = home;
const BASE = import.meta.env.BASE_URL;

// ---------- Articoli (stessa selezione della homepage precedente) ----------
const dateFormatter = new Intl.DateTimeFormat('it-IT', { day: '2-digit', month: 'short', year: 'numeric' });
const articles = (await getCollection('articles'))
  .filter((a) => a.data.featured !== false)
  .sort((a, b) => {
    const ord = (a.data.order ?? 999) - (b.data.order ?? 999);
    if (ord !== 0) return ord;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3)
  .map((a) => ({
    tag: a.data.tag,
    title: a.data.title,
    date: dateFormatter.format(a.data.date),
    href: `${BASE}articoli/${a.id}`,
  }));

// ---------- Portfolio (solo se la sezione "I lavori migliori" è attiva) ----------
const showWorks = H.works?.enabled === true;
let works: { brand: string; poster: ImageMetadata | null }[] = [];
if (showWorks) {
  const portfolioFiles = import.meta.glob<{ default: any }>('/content/portfolio/*.json', { eager: true });
  const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/images/portfolio/**/*.{png,jpg,jpeg,gif,webp}',
    { eager: true }
  );
  works = Object.values(portfolioFiles)
    .map(({ default: d }) => ({ d, poster: d.poster ? portfolioImages[d.poster]?.default ?? null : null }))
    .filter(({ d }) => d.featured !== false && d.videoSrc)
    .sort((a, b) => (a.d.order ?? 0) - (b.d.order ?? 0))
    .map(({ d, poster }) => ({ brand: d.brand || 'Progetto', poster }));
}

const reviewsUrl = (globalSettings as any).social?.googleReviewsUrl || '';
---

<Layout title={H.seo.title} description={H.seo.description} variant="home">
  <HomeNav slot="header" showPortfolio={showWorks} />

  <HomeHero data={H.hero} />
  <HomeClients data={H.clients} />
  {showWorks && <HomeWorks data={H.works} items={works} />}
  <HomeServices data={H.services} />
  {H.cases?.enabled === true && <HomeCases data={H.cases} hasPortfolio={showWorks} />}
  <HomeTeam data={H.team} />
  <HomeReviews data={H.reviews} reviewsUrl={reviewsUrl} />
  {articles.length > 0 && <HomeArticles data={H.articles} articles={articles} />}
  <HomeContact data={H.contact} />

  <HomeFooter slot="footer" data={H.footer} />

  <script>
    // Tracciamento WhatsApp
    document.querySelectorAll('a[data-cursor="whatsapp"]').forEach((el) => {
      el.addEventListener('click', () => {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'click_whatsapp', {
            event_category: 'Lead',
            event_label: 'WhatsApp contact',
          });
        }
      });
    });

    // Tracciamento telefono
    document.querySelectorAll('a[href^="tel:"]').forEach((el) => {
      el.addEventListener('click', () => {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'click_phone', {
            event_category: 'Lead',
            event_label: 'Phone contact',
          });
        }
      });
    });
  </script>
</Layout>
