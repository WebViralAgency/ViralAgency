---
import logo from '../../assets/images/home/logo/logo-viral-bianco.webp';
import globalSettings from '../../../content/settings/global.json';

interface Props {
  showPortfolio: boolean;
}

const { showPortfolio } = Astro.props;
const email = globalSettings.contact?.email || 'info@viralagency.it';

const items = [
  { label: 'Servizi', href: '#servizi' },
  ...(showPortfolio ? [{ label: 'Portfolio', href: '#portfolio' }] : []),
  { label: 'Chi siamo', href: '#team' },
  { label: 'Articoli', href: '#articoli' },
].map((item, i) => ({ ...item, num: String(i + 1).padStart(2, '0') }));
---

<header class="hv-nav">
  <a href="#home" class="hv-nav-logo" aria-label="Viral Digital Agency, home">
    <img src={logo.src} width={logo.width} height={logo.height} alt="Viral Digital Agency" decoding="async" />
  </a>

  <nav aria-label="Principale" class="hv-nav-links">
    {items.map((item) => (
      <a href={item.href}><span class="hv-nav-num">{item.num}</span> {item.label}</a>
    ))}
  </nav>

  <div class="hv-nav-actions">
    <a href="#contatti" class="hv-btn-cta hv-slant">Contattaci <span class="hv-arrow" aria-hidden="true">→</span></a>
    <button type="button" class="hv-nav-burger" id="hv-menu-open" aria-label="Apri menu" aria-expanded="false" aria-controls="hv-menu">
      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M0 1h18M0 11h18" stroke="currentColor" stroke-width="1.6"></path></svg>
    </button>
  </div>
</header>

<div id="hv-menu" class="hv-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="hv-menu-top">
    <img src={logo.src} width={logo.width} height={logo.height} alt="" decoding="async" />
    <button type="button" class="hv-nav-burger" id="hv-menu-close" aria-label="Chiudi menu">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6"></path></svg>
    </button>
  </div>
  <nav aria-label="Menu mobile" class="hv-menu-links">
    {items.map((item) => (
      <a href={item.href}>{item.label} <span aria-hidden="true">{item.num}</span></a>
    ))}
    <a href="#contatti">Contatti <span aria-hidden="true">→</span></a>
  </nav>
  <div class="hv-menu-foot">
    <p class="hv-f-label">Scrivici</p>
    <a href={`mailto:${email}`}>{email}</a>
  </div>
</div>

<script>
  const menu = document.getElementById('hv-menu');
  const openBtn = document.getElementById('hv-menu-open');
  const closeBtn = document.getElementById('hv-menu-close');

  const setOpen = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else openBtn.focus();
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) {
      menu.hidden = true;
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setOpen(false);
  });
</script>
