---
import settings from '../../content/settings/global.json';

const accessKey = settings.form?.web3formsKey || '';
const privacyHref = import.meta.env.BASE_URL + 'privacy-policy/';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="cf-form"
  id="contact-form"
  aria-label="Form contatti"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`Nuovo contatto da ${settings.companyName}`} />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="cf-header">Form contatti</div>

  <div class="cf-grid">
    <div class="cf-field">
      <label for="name" class="cf-label">Nome</label>
      <input type="text" id="name" name="name" required autocomplete="given-name" class="cf-input" placeholder="Il tuo nome" />
    </div>
    <div class="cf-field cf-field--side">
      <label for="surname" class="cf-label">Cognome</label>
      <input type="text" id="surname" name="surname" required autocomplete="family-name" class="cf-input" placeholder="Il tuo cognome" />
    </div>
    <div class="cf-field cf-field--wide">
      <label for="email" class="cf-label">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email" class="cf-input" placeholder="nome@esempio.it" />
    </div>
    <div class="cf-field cf-field--wide">
      <label for="message" class="cf-label">Messaggio</label>
      <textarea id="message" name="message" required rows="5" class="cf-input cf-textarea" placeholder="Raccontaci il tuo progetto"></textarea>
    </div>
    <label class="cf-field cf-field--wide cf-consent">
      <input type="checkbox" id="privacy" name="privacy" value="Accettata" required class="cf-check" />
      <span class="cf-consent-label">
        Ho letto la <a href={privacyHref} target="_blank" rel="noopener">Privacy Policy</a> e acconsento al trattamento
        dei miei dati per essere ricontattato.
      </span>
    </label>
  </div>

  <div class="cf-actions">
    <button type="submit" class="cf-submit">Invia richiesta <span aria-hidden="true">↗</span></button>
  </div>

  <div id="form-success" class="hidden cf-msg" role="status">
    ✓ Grazie. Ti rispondiamo entro 24 ore.
  </div>
  <div id="form-error" class="hidden cf-msg" role="alert">
    ! Errore. Scrivici direttamente via email.
  </div>
</form>

<style>
  .cf-form {
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: #1a2b4a;
    color: #fff;
  }
  .cf-header {
    padding: 18px 22px;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .cf-field {
    padding: 18px 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  @media (min-width: 768px) {
    .cf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cf-field--side { border-left: 1px solid rgba(255, 255, 255, 0.22); }
    .cf-field--wide { grid-column: span 2; }
  }
  .cf-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dce3ff;
  }
  .cf-input {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: #fff;
    font: 400 17px 'Space Grotesk', sans-serif;
    box-sizing: border-box;
  }
  .cf-textarea { resize: vertical; }
  .cf-input::placeholder { color: rgba(255, 255, 255, 0.6); }
  .cf-input:focus-visible,
  .cf-check:focus-visible,
  .cf-submit:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  .cf-consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
  }
  .cf-check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 2px 0 0;
    accent-color: #fff;
    cursor: pointer;
  }
  .cf-consent-label {
    font-size: 14px;
    line-height: 1.45;
    color: #e6ebff;
    cursor: pointer;
  }
  .cf-consent-label a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cf-actions { padding: 0 22px 22px; }
  .cf-submit {
    width: 100%;
    height: 56px;
    border: 1.5px solid #fff;
    border-radius: 999px;
    background: #fff;
    color: #10203b;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .cf-submit:hover { opacity: 0.85; }
  .cf-msg {
    margin: 0 22px 22px;
    padding: 14px 16px;
    border: 1px dashed rgba(255, 255, 255, 0.6);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
        setTimeout(() => successMsg?.classList.add('hidden'), 5000);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'form_submit_contact', {
            event_category: 'Lead',
            event_label: 'Form contatti',
          });
        }
      } else {
        throw new Error('Form submission failed');
      }
    } catch (_error) {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
    }
  });
</script>
