---
import { Image } from 'astro:assets';
import globalSettings from '../../content/settings/global.json';
import logoWordDefault from '../assets/images/brand/logo-black.png';

const brandImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/brand/**/*.{png,jpg,jpeg,gif,webp,svg}',
  { eager: true }
);

const logoWord =
  (globalSettings.logoWord && brandImages[globalSettings.logoWord]?.default) ||
  logoWordDefault;

const email = globalSettings.contact?.email || 'info@viralagency.it';

// Sulle sotto-pagine (es. /articoli/<slug>) le ancore "#manifesto" puntano
// a sezioni che non esistono in quella pagina: prefissiamo con la home.
const BASE = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const homePath = BASE.replace(/\/$/, '');
const isHome = currentPath === homePath;

// Logo: in home usa l'ancora #home (smooth scroll Lenis); fuori, vai a /
const homeHref = isHome ? '#home' : BASE;
// Le voci di menu si comportano allo stesso modo
const anchor = (a: string) => (isHome ? a : `${BASE}${a}`);

const nav = (globalSettings as any).nav ?? {};

const portfolioLabel = nav.portfolioLabel || 'Portfolio';
const portfolioMegaDesc = nav.portfolioMegaDesc || 'I nostri lavori per ogni cliente';
const aboutLabel = nav.aboutLabel || 'Chi siamo';
const aboutMegaDesc = nav.aboutMegaDesc || 'Storytelling, team & servizi';
const articlesLabel = nav.articlesLabel || 'Articoli';
const contactLabel = nav.contactLabel || 'Contatti';

const portfolioMenu = [
  { label: 'Lavori', href: anchor('#portfolio') },
  { label: 'Recensioni', href: anchor('#recensioni') },
];

const aboutMenu = [
  { label: 'Servizi', href: anchor('#servizi') },
  { label: 'Il team', href: anchor('#team') },
];
---

<header id="site-header" class="nav-root">
  <nav class="container-custom">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href={homeHref} class="inline-flex items-center gap-2 nav-logo" aria-label={globalSettings.companyName}>
        <Image src={logoWord} alt={globalSettings.companyName} width={120} height={28} class="h-5 w-auto" format="webp" quality={90} />
        <span class="nav-dot" aria-hidden="true"></span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-1">
        <div class="nav-item">
          <a href={anchor('#portfolio')} class="nav-link">{portfolioLabel}</a>
          <div class="megamenu">
            <p class="mono-label mb-3">{portfolioMegaDesc}</p>
            <div class="megamenu-grid">
              {portfolioMenu.map((item) => (
                <a href={item.href} class="megamenu-link">
                  <span>{item.label}</span>
                  <span class="arr">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="nav-item">
          <a href={anchor('#servizi')} class="nav-link">{aboutLabel}</a>
          <div class="megamenu">
            <p class="mono-label mb-3">{aboutMegaDesc}</p>
            <div class="megamenu-grid">
              {aboutMenu.map((item) => (
                <a href={item.href} class="megamenu-link">
                  <span>{item.label}</span>
                  <span class="arr">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href={anchor('#articoli')} class="nav-link">{articlesLabel}</a>
      </div>

      <!-- Right: Contatti → scroll to #contatti -->
      <div class="hidden lg:flex items-center gap-3">
        <a href={anchor('#contatti')} class="nav-link is-cta" data-cursor="scrivici">
          {contactLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Mobile button -->
      <button
        type="button"
        class="lg:hidden p-2"
        id="mobile-menu-button"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 17h16" id="menu-icon-open" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" id="menu-icon-close" class="hidden" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile full-screen overlay (outside nav-root to avoid blend-mode bugs) -->
<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-50 bg-[var(--ink)] text-[var(--paper)] overflow-y-auto"
  aria-hidden="true"
>
  <div class="container-custom pt-24 pb-12 min-h-screen flex flex-col">
    <div class="flex-1">
      <p class="mono-label opacity-60 mb-8">Menu</p>
      <nav class="flex flex-col gap-5">
        <a href={anchor('#portfolio')} class="mm-link">{portfolioLabel} <span>↗</span></a>
        <a href={anchor('#servizi')} class="mm-link">{aboutLabel} <span>↗</span></a>
        <a href={anchor('#servizi')} class="mm-link">Servizi <span>↗</span></a>
        <a href={anchor('#articoli')} class="mm-link">{articlesLabel} <span>↗</span></a>
        <a href={anchor('#contatti')} class="mm-link">{contactLabel} <span>↗</span></a>
      </nav>
    </div>
    <div class="pt-8 mt-8 border-t border-white/10">
      <p class="mono-label opacity-60 mb-2">Scrivici</p>
      <a href={`mailto:${email}`} class="h-display text-2xl block">{email}</a>
    </div>
  </div>
</div>

<style>
  .mm-link {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--paper);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(245, 243, 238, 0.1);
    transition: padding 0.3s var(--ease-out);
  }
  .mm-link:hover { padding-left: 1rem; color: var(--electric); }
  .mm-link span { font-family: var(--font-mono); font-size: 1.2rem; opacity: 0.5; }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  // On the NOVA homepage the header is transparent + white while it sits over
  // the dark scroll-video hero, then becomes the solid bar over light content.
  const heroEl = document.querySelector<HTMLElement>('.nova-scope');

  // Scrolled state for navbar (+ over-hero state on the video homepage)
  const onScroll = () => {
    if (!header) return;
    const y = window.scrollY;
    if (y > 24) header.classList.add('is-scrolled');
    else header.classList.remove('is-scrolled');

    if (heroEl) {
      const heroBottom = heroEl.offsetTop + heroEl.offsetHeight;
      // White header while the dark hero is still behind the bar.
      if (y < heroBottom - header.offsetHeight - 8) header.classList.add('is-over-hero');
      else header.classList.remove('is-over-hero');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  function toggleMenu(open: boolean) {
    if (!mobileMenu) return;
    if (open) {
      mobileMenu.classList.remove('hidden');
      mobileMenu.setAttribute('aria-hidden', 'false');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('hidden');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }
    menuButton?.setAttribute('aria-expanded', String(open));
  }

  menuButton?.addEventListener('click', () => {
    toggleMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  function goToMenuLink(link: HTMLAnchorElement) {
    const href = link.getAttribute('href');
    if (!href) return;

    if (href.startsWith('mailto:') || href.startsWith('tel:')) {
      window.location.href = href;
      return;
    }

    const targetUrl = new URL(link.href, window.location.href);
    const currentPath = `${window.location.origin}${window.location.pathname}`;
    const targetPath = `${targetUrl.origin}${targetUrl.pathname}`;

    if (targetUrl.origin === window.location.origin && targetUrl.hash && targetPath === currentPath) {
      const target = document.querySelector<HTMLElement>(targetUrl.hash);
      if (target) {
        history.pushState(null, '', targetUrl.hash);
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        return;
      }
    }

    window.location.href = targetUrl.href;
  }

  // Fallback utile per gli anchor link gestiti da smooth scroll / hash navigation.
  window.addEventListener('hashchange', () => toggleMenu(false));

  // Un solo punto di controllo per i click del menu mobile.
  // Deve girare in capture perché lo smooth scroll globale intercetta gli anchor.
  mobileMenu?.addEventListener(
    'click',
    (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>('a');
      if (link && mobileMenu.contains(link)) {
        event.preventDefault();
        event.stopPropagation();
        toggleMenu(false);
        goToMenuLink(link);
        return;
      }

      if (event.target === mobileMenu) toggleMenu(false);
    },
    { capture: true }
  );

  // Close mega-menu after clicking one of its links
  // (otherwise :focus-within keeps the dropdown open)
  // Smooth scroll for anchors is handled globally by Lenis in Layout.astro.
  document.querySelectorAll<HTMLAnchorElement>('.megamenu-link').forEach((link) => {
    link.addEventListener('click', () => {
      const item = link.closest('.nav-item') as HTMLElement | null;
      link.blur();
      if (item) {
        item.classList.add('is-dismissed');
        setTimeout(() => item.classList.remove('is-dismissed'), 500);
      }
    });
  });

</script>
